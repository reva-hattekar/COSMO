# COSMO Backend Configuration

# Server Port
PORT=3000
NODE_ENV=production

# Database (DATABASE_PATH prioritized over DB_PATH, defaults to ./data/cosmo.db)
DATABASE_PATH=./data/cosmo.db

# Optional API Security Key
# When configured, requires 'Authorization: Bearer <COSMO_API_KEY>' on reminders and database routes.
# Keep unset or empty in development for open access.
# COSMO_API_KEY=your_secure_random_api_key_here

# Google OAuth 2.0 Credentials (for Reminders dashboard)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

