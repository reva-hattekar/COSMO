{
  "name": "cosmo-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js backend for COSMO services (Google Reminders & Knowledge Database)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/db/seed.js",
    "test": "node tests/test-db.js",
    "test:api": "node tests/test-api.js",
    "test:google": "node tests/test-google.js",
    "test:all": "node tests/test-db.js && node tests/test-api.js && node tests/test-google.js",
    "test:ingestion": "node tests/test-ingestion.js",
    "import:500": "node src/ingestion/cli.js test-500",
    "import:quality": "node src/ingestion/cli.js quality",
    "import:status": "node src/ingestion/cli.js status"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "sqlite3": "^6.0.1"
  }
}
